<Window x:Class="SnapSharp.Views.SelectionWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SnapSharp.Views"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" AllowsTransparency="True" Background="Black"
        Cursor="Cross" KeyDown="Window_KeyDown" PreviewKeyUp="Window_KeyUp"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseRightButtonDown="Window_PreviewMouseRightButtonDown">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ToolbarStyles.xaml" /></ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid x:Name="Root" ClipToBounds="True"
        MouseLeftButtonDown="Root_MouseLeftButtonDown"
        MouseMove="Root_MouseMove"
        MouseLeftButtonUp="Root_MouseLeftButtonUp">
    <Grid.Resources>
      <Style x:Key="SelectionHandleStyle" TargetType="primitives:Thumb">
        <Setter Property="Width" Value="12" /><Setter Property="Height" Value="12" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="#398BFF" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="primitives:Thumb">
          <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}"
                   StrokeThickness="{TemplateBinding BorderThickness}" />
        </ControlTemplate></Setter.Value></Setter>
      </Style>
    </Grid.Resources>
    <Image x:Name="Screenshot" Stretch="Fill" SnapsToDevicePixels="True" />
    <Path x:Name="Shade" Fill="#8A000000" IsHitTestVisible="False" />
    <Path x:Name="ShapeOutline" Stroke="#398BFF" StrokeThickness="2" Fill="Transparent"
          StrokeLineJoin="Round" Visibility="Collapsed" IsHitTestVisible="False" />
    <Image x:Name="EditedImageView" Visibility="Collapsed" Stretch="Fill" SnapsToDevicePixels="True"
           HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
    <local:AnnotationSurface x:Name="AnnotationView" Visibility="Collapsed"
                             HorizontalAlignment="Left" VerticalAlignment="Top" />
    <Border x:Name="SelectionBorder" BorderBrush="#398BFF" BorderThickness="2"
            Visibility="Collapsed" IsHitTestVisible="False" />

    <Border x:Name="InfoPanel" HorizontalAlignment="Left" VerticalAlignment="Top"
            Background="{DynamicResource OverlaySurfaceBrush}" CornerRadius="14" Padding="10,4" IsHitTestVisible="False">
      <TextBlock x:Name="InfoText" Foreground="{DynamicResource OverlayTextBrush}" FontFamily="Consolas" FontSize="12" />
    </Border>

    <Border x:Name="Magnifier" Width="286" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top"
            Background="{DynamicResource OverlaySurfaceBrush}" BorderBrush="#99000000" BorderThickness="1" CornerRadius="7"
            IsHitTestVisible="False" SnapsToDevicePixels="True">
      <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.38" Color="#000000" /></Border.Effect>
      <Grid Margin="9">
        <Grid.RowDefinitions><RowDefinition Height="154" /><RowDefinition /></Grid.RowDefinitions>
        <Grid ClipToBounds="True" Width="266" Height="154" Background="Black">
          <Image x:Name="ZoomImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True" />
          <Canvas IsHitTestVisible="False">
            <Rectangle Width="126" Height="14" Canvas.Top="70" Fill="#66398BFF" />
            <Rectangle Width="126" Height="14" Canvas.Left="140" Canvas.Top="70" Fill="#66398BFF" />
            <Rectangle Width="14" Height="70" Canvas.Left="126" Fill="#66398BFF" />
            <Rectangle Width="14" Height="70" Canvas.Left="126" Canvas.Top="84" Fill="#66398BFF" />
          </Canvas>
          <Canvas x:Name="MagnifierPixelGrid" IsHitTestVisible="False" />
          <Rectangle Width="14" Height="14" Stroke="#FF202020" StrokeThickness="3"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Rectangle Width="14" Height="14" Stroke="White" StrokeThickness="1"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <Border Grid.Row="1" Background="#E6000000" CornerRadius="0,0,4,4" Padding="4,5">
          <StackPanel>
            <TextBlock x:Name="ColorCoordinates" Foreground="White" FontFamily="Consolas" FontSize="14" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3">
            <Border x:Name="MagnifierColorSwatch" Width="16" Height="16" CornerRadius="3"
                    BorderBrush="#CCFFFFFF" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock x:Name="ColorText" Foreground="White" FontFamily="Consolas" FontSize="13"
                       VerticalAlignment="Center" TextWrapping="NoWrap" />
            </StackPanel>
            <TextBlock x:Name="ColorFormatText" Foreground="#FFC7CDD6" FontSize="10.5" HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBlock Text="Shift：切换颜色格式" Foreground="White" FontSize="13" HorizontalAlignment="Center" />
            <TextBlock Text="C：复制颜色值并退出截图" Foreground="White" FontSize="13" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <TextBlock x:Name="Hint" Text="拖动选择区域  |  单击选中窗口  |  选区后右键重选  |  Tab 切换模式  |  Esc 取消" Foreground="{DynamicResource OverlayTextBrush}"
               Background="{DynamicResource OverlaySurfaceBrush}" Padding="12,7" HorizontalAlignment="Center"
               VerticalAlignment="Top" Margin="0,18,0,0" IsHitTestVisible="False" />

    <!-- Keep the visibility marker non-interactive. The resize thumbs are direct
         siblings so an empty full-screen panel cannot intercept annotation input. -->
    <Border x:Name="Handles" Width="0" Height="0" Visibility="Collapsed" IsHitTestVisible="False" />
    <primitives:Thumb x:Name="TopLeftHandle" Style="{StaticResource SelectionHandleStyle}"
                      Visibility="{Binding Visibility, ElementName=Handles}" Tag="TopLeft" Cursor="SizeNWSE" DragDelta="Handle_DragDelta" DragCompleted="Handle_DragCompleted" />
    <primitives:Thumb x:Name="TopCenterHandle" Style="{StaticResource SelectionHandleStyle}"
                      Visibility="{Binding Visibility, ElementName=Handles}" Tag="Top" Cursor="SizeNS" DragDelta="Handle_DragDelta" DragCompleted="Handle_DragCompleted" />
    <primitives:Thumb x:Name="TopRightHandle" Style="{StaticResource SelectionHandleStyle}"
                      Visibility="{Binding Visibility, ElementName=Handles}" Tag="TopRight" Cursor="SizeNESW" DragDelta="Handle_DragDelta" DragCompleted="Handle_DragCompleted" />
    <primitives:Thumb x:Name="MiddleLeftHandle" Style="{StaticResource SelectionHandleStyle}"
                      Visibility="{Binding Visibility, ElementName=Handles}" Tag="Left" Cursor="SizeWE" DragDelta="Handle_DragDelta" DragCompleted="Handle_DragCompleted" />
    <primitives:Thumb x:Name="MiddleRightHandle" Style="{StaticResource SelectionHandleStyle}"
                      Visibility="{Binding Visibility, ElementName=Handles}" Tag="Right" Cursor="SizeWE" DragDelta="Handle_DragDelta" DragCompleted="Handle_DragCompleted" />
    <primitives:Thumb x:Name="BottomLeftHandle" Style="{StaticResource SelectionHandleStyle}"
                      Visibility="{Binding Visibility, ElementName=Handles}" Tag="BottomLeft" Cursor="SizeNESW" DragDelta="Handle_DragDelta" DragCompleted="Handle_DragCompleted" />
    <primitives:Thumb x:Name="BottomCenterHandle" Style="{StaticResource SelectionHandleStyle}"
                      Visibility="{Binding Visibility, ElementName=Handles}" Tag="Bottom" Cursor="SizeNS" DragDelta="Handle_DragDelta" DragCompleted="Handle_DragCompleted" />
    <primitives:Thumb x:Name="BottomRightHandle" Style="{StaticResource SelectionHandleStyle}"
                      Visibility="{Binding Visibility, ElementName=Handles}" Tag="BottomRight" Cursor="SizeNWSE" DragDelta="Handle_DragDelta" DragCompleted="Handle_DragCompleted" />

    <Border x:Name="CapturePanel" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,54,0,0"
            Background="{DynamicResource OverlaySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="6" Padding="5">
      <StackPanel Orientation="Horizontal">
        <ComboBox x:Name="CaptureModePicker" Width="82" SelectionChanged="CaptureMode_Changed" ToolTip="捕获模式">
          <ComboBoxItem Content="区域" Tag="Region" IsSelected="True" />
          <ComboBoxItem Content="窗口" Tag="Window" />
          <ComboBoxItem Content="全屏" Tag="FullScreen" />
        </ComboBox>
        <ComboBox x:Name="ShapePicker" Width="92" Margin="5,0,0,0" SelectionChanged="Shape_Changed" ToolTip="选区形状">
          <ComboBoxItem Content="矩形" Tag="Rectangle" IsSelected="True" />
          <ComboBoxItem Content="椭圆" Tag="Ellipse" />
          <ComboBoxItem Content="自由套索" Tag="Lasso" />
          <ComboBoxItem Content="多边形" Tag="Polygon" />
        </ComboBox>
        <ComboBox x:Name="RatioPicker" Width="76" Margin="5,0,0,0" SelectionChanged="Ratio_Changed" ToolTip="锁定比例">
          <ComboBoxItem Content="自由" Tag="Free" IsSelected="True" />
          <ComboBoxItem Content="1:1" Tag="1" />
          <ComboBoxItem Content="4:3" Tag="1.333333333333" />
          <ComboBoxItem Content="16:9" Tag="1.777777777778" />
        </ComboBox>
      </StackPanel>
    </Border>

    <Border x:Name="ToolPanel" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
            Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="1" CornerRadius="10"
            Padding="8,6" MaxWidth="1040" TextElement.FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
      <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.42" Color="{DynamicResource ToolbarShadowColor}" /></Border.Effect>
      <Border.Resources>
        <Style x:Key="CaptureToolButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}" />
        <Style x:Key="PrimaryArrowOptionButton" TargetType="Button" BasedOn="{StaticResource CaptureToolButton}">
          <Setter Property="Width" Value="104" /><Setter Property="Height" Value="32" />
          <Setter Property="MinWidth" Value="104" /><Setter Property="Margin" Value="0,1" />
          <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style TargetType="Separator" BasedOn="{StaticResource ToolbarSeparator}" />
        <Style TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource ToolbarIcon}" />
      </Border.Resources>
      <WrapPanel x:Name="ToolButtons" Orientation="Horizontal" VerticalAlignment="Top">
        <Button x:Name="MoveSelectionButton" Style="{StaticResource CaptureToolButton}" Click="MoveSelection_Click" ToolTip="移动选区"><iconPacks:PackIconLucide Kind="Move" /></Button>
        <Separator />
        <local:ToolGroupButton x:Name="ShapeTools" Group="Shapes" ToolSelected="ToolGroup_ToolSelected" />
        <Button Style="{StaticResource CaptureToolButton}" Tag="Line" Click="Tool_Click" ToolTip="直线"><iconPacks:PackIconLucide Kind="Minus" /></Button>
        <Button Style="{StaticResource CaptureToolButton}" Tag="Arrow" Click="Tool_Click" ToolTip="箭头"><iconPacks:PackIconLucide Kind="ArrowUpRight" /></Button>
        <Grid Width="14" Height="32" Margin="-5,0,2,0">
          <ToggleButton x:Name="PrimaryArrowStyleDropDownToggle" Width="14" Height="32" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" ToolTip="选择箭头样式">
            <ToggleButton.Template>
              <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="PrimaryArrowDropSurface" Background="{TemplateBinding Background}" CornerRadius="4">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PrimaryArrowDropSurface" Property="Background" Value="{DynamicResource ControlHoverBrush}" /></Trigger>
                  <Trigger Property="IsChecked" Value="True"><Setter TargetName="PrimaryArrowDropSurface" Property="Background" Value="{DynamicResource ToolbarActiveBrush}" /></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </ToggleButton.Template>
            <iconPacks:PackIconLucide Kind="ChevronDown" Width="12" Height="12" Foreground="{DynamicResource TextSecondaryBrush}" />
          </ToggleButton>
          <Popup PlacementTarget="{Binding ElementName=PrimaryArrowStyleDropDownToggle}" Placement="Bottom"
                 HorizontalOffset="-43" VerticalOffset="5" AllowsTransparency="True" PopupAnimation="Fade"
                 StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=PrimaryArrowStyleDropDownToggle, Mode=TwoWay}">
            <Border Width="116" Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="4">
              <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.58" Color="#000000" /></Border.Effect>
              <StackPanel x:Name="PrimaryArrowStyleMenu">
                <Button Style="{StaticResource PrimaryArrowOptionButton}" Tag="TaperedOutline" Click="PrimaryArrowStyleButton_Click" ToolTip="渐细空心箭头"><local:ArrowStylePreview ArrowStyle="TaperedOutline" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                <Button Style="{StaticResource PrimaryArrowOptionButton}" Tag="TaperedFilled" Click="PrimaryArrowStyleButton_Click" ToolTip="渐细实心箭头"><local:ArrowStylePreview ArrowStyle="TaperedFilled" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                <Button Style="{StaticResource PrimaryArrowOptionButton}" Tag="EndOpen" Click="PrimaryArrowStyleButton_Click" ToolTip="单向箭头"><local:ArrowStylePreview ArrowStyle="EndOpen" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                <Button Style="{StaticResource PrimaryArrowOptionButton}" Tag="BothOpen" Click="PrimaryArrowStyleButton_Click" ToolTip="双向箭头"><local:ArrowStylePreview ArrowStyle="BothOpen" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                <Button Style="{StaticResource PrimaryArrowOptionButton}" Tag="StartOpen" Click="PrimaryArrowStyleButton_Click" ToolTip="反向箭头"><local:ArrowStylePreview ArrowStyle="StartOpen" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                <Button Style="{StaticResource PrimaryArrowOptionButton}" Tag="EndFilled" Click="PrimaryArrowStyleButton_Click" ToolTip="实心箭头"><local:ArrowStylePreview ArrowStyle="EndFilled" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                <Button Style="{StaticResource PrimaryArrowOptionButton}" Tag="BothFilled" Click="PrimaryArrowStyleButton_Click" ToolTip="双向实心箭头"><local:ArrowStylePreview ArrowStyle="BothFilled" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                <Button Style="{StaticResource PrimaryArrowOptionButton}" Tag="EndOpenStartBar" Click="PrimaryArrowStyleButton_Click" ToolTip="起点端线箭头"><local:ArrowStylePreview ArrowStyle="EndOpenStartBar" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                <Button Style="{StaticResource PrimaryArrowOptionButton}" Tag="StartOpenEndBar" Click="PrimaryArrowStyleButton_Click" ToolTip="终点端线箭头"><local:ArrowStylePreview ArrowStyle="StartOpenEndBar" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
                <Button Style="{StaticResource PrimaryArrowOptionButton}" Tag="Bars" Click="PrimaryArrowStyleButton_Click" ToolTip="双端线"><local:ArrowStylePreview ArrowStyle="Bars" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
              </StackPanel>
            </Border>
          </Popup>
        </Grid>
        <Separator />
        <local:ToolGroupButton x:Name="InkTools" Group="Ink" ToolSelected="ToolGroup_ToolSelected" />
        <Separator />
        <local:ToolGroupButton x:Name="TextTools" Group="Text" ToolSelected="ToolGroup_ToolSelected" />
        <Button Style="{StaticResource CaptureToolButton}" Tag="Number" Click="Tool_Click" ToolTip="序号标注">
          <Viewbox Width="18" Height="18">
            <Canvas Width="24" Height="24">
              <Ellipse Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" />
              <Path Data="M 10,9 L 12,7.5 L 12,16 M 10,16 L 14,16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Canvas>
          </Viewbox>
        </Button>
        <Separator />
        <local:ToolGroupButton x:Name="EffectTools" Group="Effects" ToolSelected="ToolGroup_ToolSelected" />
        <Separator />
        <Button Style="{StaticResource CaptureToolButton}" Tag="Select" Click="Tool_Click" ToolTip="选择对象"><iconPacks:PackIconLucide Kind="MousePointer2" /></Button>
        <Button Style="{StaticResource CaptureToolButton}" Tag="Eraser" Click="Tool_Click" ToolTip="删除标注"><iconPacks:PackIconLucide Kind="Eraser" /></Button>
        <Separator />
        <Button Style="{StaticResource CaptureToolButton}" Click="Color_Click" ToolTip="标注颜色"><iconPacks:PackIconLucide Kind="Palette" /></Button>
        <Button Style="{StaticResource CaptureToolButton}" Command="{Binding UndoCommand}" ToolTip="撤销 (Ctrl+Z)"><iconPacks:PackIconLucide Kind="Undo2" /></Button>
        <Button Style="{StaticResource CaptureToolButton}" Command="{Binding RedoCommand}" ToolTip="重做 (Ctrl+Y)"><iconPacks:PackIconLucide Kind="Redo2" /></Button>
        <Menu Visibility="Collapsed" Height="32" FontSize="13" Background="Transparent" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center">
          <Menu.Resources>
            <Style TargetType="Separator" BasedOn="{StaticResource AppMenuSeparator}" />
            <Style TargetType="MenuItem" BasedOn="{StaticResource AppMenuItem}" />
          </Menu.Resources>
          <MenuItem Header="对象">
            <MenuItem Header="复制对象 (Ctrl+C)" Click="ObjectCopy_Click" />
            <MenuItem Header="粘贴对象 (Ctrl+V)" Click="ObjectPaste_Click" />
            <MenuItem Header="删除对象 (Delete)" Click="ObjectDelete_Click" />
            <Separator />
            <MenuItem Header="上移一层" Click="LayerUp_Click" />
            <MenuItem Header="下移一层" Click="LayerDown_Click" />
            <MenuItem Header="置于顶层" Click="LayerTop_Click" />
            <MenuItem Header="置于底层" Click="LayerBottom_Click" />
          </MenuItem>
          <MenuItem Header="图像">
            <MenuItem Header="顺时针旋转 90°" Click="RotateClockwise_Click" />
            <MenuItem Header="逆时针旋转 90°" Click="RotateCounterClockwise_Click" />
            <MenuItem Header="水平翻转（文字保持可读）" Click="FlipHorizontal_Click" />
            <MenuItem Header="垂直翻转（文字保持可读）" Click="FlipVertical_Click" />
            <MenuItem Header="扩展画布…" Click="ExpandCanvas_Click" />
          </MenuItem>
          <MenuItem Header="模板">
            <MenuItem Header="导出标注模板…" Click="SaveTemplate_Click" />
            <MenuItem Header="导入标注模板…" Click="LoadTemplate_Click" />
          </MenuItem>
        </Menu>
        <Separator />
        <Button x:Name="ScrollCaptureButton" Style="{StaticResource CaptureToolButton}" Click="ScrollCapture_Click" ToolTip="滚动长截图"><iconPacks:PackIconLucide Kind="MoveVertical" /></Button>
        <Button x:Name="PinCaptureButton" Style="{StaticResource CaptureToolButton}" Click="Pin_Click" ToolTip="置顶贴图"><iconPacks:PackIconLucide Kind="Pin" /></Button>
        <Button x:Name="RecognitionCaptureButton" Style="{StaticResource CaptureToolButton}" Click="Recognition_Click" ToolTip="文字、条码与表格识别"><iconPacks:PackIconLucide Kind="ScanText" /></Button>
        <Button x:Name="CutoutCaptureButton" Style="{StaticResource CaptureToolButton}" Click="Cutout_Click" ToolTip="一键抠图（需配置 ONNX 模型）"><iconPacks:PackIconLucide Kind="Scissors" /></Button>
        <Button x:Name="RecordingCaptureButton" Style="{StaticResource CaptureToolButton}" Click="Recording_Click" ToolTip="录制这个区域（不包含截图标注）"><iconPacks:PackIconLucide Kind="Video" /></Button>
        <Button x:Name="SaveCaptureButton" Style="{StaticResource CaptureToolButton}" Click="Save_Click" ToolTip="保存"><iconPacks:PackIconLucide Kind="Download" /></Button>
        <Button x:Name="PrimaryCaptureButton" Style="{StaticResource CaptureToolButton}" Click="Copy_Click" ToolTip="复制到剪贴板" Background="{DynamicResource ToolbarActiveBrush}" Foreground="{DynamicResource AccentForegroundBrush}"><iconPacks:PackIconLucide Kind="Copy" /></Button>
        <Button Style="{StaticResource CaptureToolButton}" Click="Cancel_Click" ToolTip="取消"><iconPacks:PackIconLucide Kind="X" /></Button>
      </WrapPanel>
    </Border>

    <Border x:Name="SecondaryToolPanel" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
            Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="1"
            CornerRadius="10" Padding="8,6" MaxWidth="1040" TextElement.FontSize="13"
            UseLayoutRounding="True" SnapsToDevicePixels="True">
      <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.42" Color="{DynamicResource ToolbarShadowColor}" /></Border.Effect>
      <Border.Resources>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}" />
        <Style x:Key="SecondarySeparator" TargetType="Separator" BasedOn="{StaticResource ToolbarSeparator}" />
        <Style TargetType="TextBox" BasedOn="{StaticResource ToolbarTextBox}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource ToolbarComboBox}" />
        <Style TargetType="CheckBox" BasedOn="{StaticResource ToolbarCheckBox}" />
        <Style x:Key="LineStyleOptionButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
          <Setter Property="Width" Value="Auto" /><Setter Property="MinWidth" Value="0" />
          <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="Margin" Value="0,1" />
          <Setter Property="Padding" Value="10,3" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
          <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
          <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SecondaryGroupBorder" TargetType="Border">
          <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource ToolbarBorderBrush}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="CornerRadius" Value="6" />
          <Setter Property="Padding" Value="3,2" />
        </Style>
        <Style x:Key="ThicknessSliderStyle" TargetType="Slider" BasedOn="{StaticResource ParameterSlider}" />
        <Style x:Key="ColorSwatchButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
          <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" />
          <Setter Property="MinWidth" Value="32" /><Setter Property="Margin" Value="0" />
          <Setter Property="Padding" Value="3" /><Setter Property="BorderThickness" Value="1" />
          <Setter Property="BorderBrush" Value="{DynamicResource ToolbarBorderBrush}" />
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Grid>
              <Ellipse Margin="4" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}"
                       StrokeThickness="{TemplateBinding BorderThickness}" />
              <Ellipse x:Name="HoverRing" Margin="2" Stroke="{DynamicResource TextBrush}"
                       StrokeThickness="1" Opacity="0" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HoverRing" Property="Opacity" Value="0.55" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.72" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource ToolbarIcon}" />
      </Border.Resources>
      <WrapPanel x:Name="SecondaryToolButtons" Orientation="Horizontal" VerticalAlignment="Top" MinHeight="32">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="4" Height="20" CornerRadius="2" Background="{DynamicResource ToolbarActiveBrush}" Margin="0,0,7,0" />
            <TextBlock x:Name="SecondaryToolTitle" Text="工具设置" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Separator Style="{StaticResource SecondarySeparator}" />
          </StackPanel>

          <WrapPanel x:Name="NumberOptions" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="NumberValueLabel" Text="起始" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
            <Button Style="{StaticResource SecondaryButton}" Tag="-1" Click="NumberStep_Click" ToolTip="上一个序号"><iconPacks:PackIconLucide Kind="ChevronDown" /></Button>
            <TextBox x:Name="NumberValueBox" Width="48" Text="1" TextAlignment="Center"
                     LostKeyboardFocus="NumberValueBox_LostKeyboardFocus" PreviewKeyDown="NumberValueBox_KeyDown" />
            <Button Style="{StaticResource SecondaryButton}" Tag="1" Click="NumberStep_Click" ToolTip="下一个序号"><iconPacks:PackIconLucide Kind="ChevronUp" /></Button>
            <ComboBox x:Name="NumberStylePicker" Width="82" Margin="6,0,0,0" SelectionChanged="NumberStyle_Changed">
              <ComboBoxItem Content="1, 2, 3" Tag="Arabic" IsSelected="True" />
              <ComboBoxItem Content="I, II, III" Tag="UpperRoman" />
              <ComboBoxItem Content="a, b, c" Tag="LowerAlpha" />
              <ComboBoxItem Content="A, B, C" Tag="UpperAlpha" />
            </ComboBox>
            <CheckBox x:Name="ContinuousNumberToggle" Content="连续编号" Margin="8,0,0,0" VerticalAlignment="Center"
                      IsChecked="True" Click="ContinuousNumber_Changed" />
            <Separator Style="{StaticResource SecondarySeparator}" />
          </WrapPanel>

          <WrapPanel x:Name="FillOptions" Orientation="Horizontal" VerticalAlignment="Center">
            <CheckBox x:Name="FillToggle" Content="填充" Foreground="{DynamicResource TextBrush}" Margin="2,0,4,0"
                      VerticalAlignment="Center" Click="Fill_Changed" />
            <Grid Margin="4,0,0,0">
              <ToggleButton Style="{StaticResource ToolbarFieldToggle}" x:Name="FillOpacityDropDownToggle" Width="76" Height="32" Background="{DynamicResource ControlBrush}"
                            BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="1" Cursor="Hand" ToolTip="调整填充透明度"
