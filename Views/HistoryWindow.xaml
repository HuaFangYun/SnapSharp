<Window x:Class="NimCap.Screenshot.Views.HistoryWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="http://wpflocalizeextension.codeplex.com"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:CaptureHistory}" Width="760" Height="560" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ListBox x:Name="HistoryList" Background="{DynamicResource WindowBackgroundBrush}" BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Width="210" Margin="5" Padding="6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
              <Image Source="{Binding Thumbnail}" Height="130" Stretch="Uniform" />
              <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Margin="0,6,0,0" />
              <TextBlock Foreground="{DynamicResource TextSecondaryBrush}">
                <Run Text="{Binding Width, Mode=OneWay}" /><Run Text=" x " /><Run Text="{Binding Height, Mode=OneWay}" />
              </TextBlock>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Copy}" Click="Copy_Click" />
      <Button Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Pins}" Click="Pin_Click" />
      <Button Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:SaveAs}" Click="SaveAs_Click" />
      <Button Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Delete}" Click="Delete_Click" />
      <Button Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Close}" Click="Close_Click" />
    </StackPanel>
  </Grid>
</Window>
