<Window x:Class="SnapSharp.Views.RecordingWindow" Style="{StaticResource AppWindow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="http://wpflocalizeextension.codeplex.com"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Loc SnapSharp.Core:Resources.Strings:RecordingOptionsSnapSharp}" Width="700" Height="740" MinWidth="620" MinHeight="540" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Window.Resources><ResourceDictionary>
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ToolbarStyles.xaml" /></ResourceDictionary.MergedDictionaries>
    <Style TargetType="Button" BasedOn="{StaticResource DialogButton}"><Setter Property="Width" Value="Auto" /><Setter Property="MinWidth" Value="90" /><Setter Property="Margin" Value="0,6,8,6" /><Setter Property="Padding" Value="12,6" /></Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource ToolbarComboBox}"><Setter Property="Margin" Value="0,6,0,14" /></Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource ToolbarTextBox}"><Setter Property="Margin" Value="0,6,0,14" /></Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource ToolbarCheckBox}"><Setter Property="Margin" Value="0,6,14,8" /></Style>
  </ResourceDictionary></Window.Resources>
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12"><TextBlock Text="{loc:Loc SnapSharp.Core:Resources.Strings:RegionRecording}" FontSize="24" FontWeight="SemiBold" /><TextBlock x:Name="RegionLabel" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" /><Button x:Name="SetupButton" Content="{loc:Loc SnapSharp.Core:Resources.Strings:CheckAndSetUpRecording}" Click="Setup_Click" HorizontalAlignment="Left" /></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock x:Name="RunningConfigurationHint" Text="{loc:Loc SnapSharp.Core:Resources.Strings:YouCanViewOptionsWhileRecordingAnd}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" Visibility="Collapsed" />
      <StackPanel x:Name="OptionsPanel">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{loc:Loc SnapSharp.Core:Resources.Strings:OutputFormat}" /><ComboBox x:Name="FormatBox" SelectionChanged="Format_Changed"><ComboBoxItem Content="MP4（H.264 + AAC）" Tag="MP4" /><ComboBoxItem Content="{loc:Loc SnapSharp.Core:Resources.Strings:GIFNoAudioUpTo60Seconds}" Tag="GIF" /></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{loc:Loc SnapSharp.Core:Resources.Strings:FrameRateGIFUpTo15}" /><ComboBox x:Name="FrameRateBox"><ComboBoxItem Content="15 fps" Tag="15" /><ComboBoxItem Content="30 fps" Tag="30" /><ComboBoxItem Content="60 fps" Tag="60" /></ComboBox></StackPanel></Grid>
      <TextBlock Text="{loc:Loc SnapSharp.Core:Resources.Strings:QualityPreset}" /><ComboBox x:Name="QualityBox"><ComboBoxItem Content="{loc:Loc SnapSharp.Core:Resources.Strings:Smooth}" Tag="流畅" /><ComboBoxItem Content="{loc:Loc SnapSharp.Core:Resources.Strings:Standard}" Tag="标准" /><ComboBoxItem Content="{loc:Loc SnapSharp.Core:Resources.Strings:High}" Tag="高清" /></ComboBox>
      <TextBlock Text="{loc:Loc SnapSharp.Core:Resources.Strings:CaptureEngineWGCRecommendedTryDXGIFor}" /><ComboBox x:Name="CaptureBackendBox"><ComboBoxItem Content="Windows Graphics Capture" Tag="WGC" /><ComboBoxItem Content="Desktop Duplication（DXGI）" Tag="DXGI" /></ComboBox>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{loc:Loc SnapSharp.Core:Resources.Strings:MP4BitrateKbps0Automatic}" /><TextBox x:Name="BitrateBox" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{loc:Loc SnapSharp.Core:Resources.Strings:Countdown010Seconds}" /><TextBox x:Name="CountdownBox" /></StackPanel></Grid>
      <WrapPanel><CheckBox x:Name="HardwareBox" Content="{loc:Loc SnapSharp.Core:Resources.Strings:PreferHardwareEncoding}" /><CheckBox x:Name="CursorBox" Content="{loc:Loc SnapSharp.Core:Resources.Strings:ShowPointer}" /><CheckBox x:Name="ClicksBox" Content="{loc:Loc SnapSharp.Core:Resources.Strings:HighlightClicks}" /></WrapPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{loc:Loc SnapSharp.Core:Resources.Strings:StopAfterRecordedSeconds0Manual}" /><TextBox x:Name="StopAfterBox" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{loc:Loc SnapSharp.Core:Resources.Strings:GIFLongestEdge160800Pixels}" /><TextBox x:Name="GifEdgeBox" /></StackPanel></Grid>
      <TextBlock Text="{loc:Loc SnapSharp.Core:Resources.Strings:RecordingRememberOptionsHint}" FontWeight="SemiBold" Margin="0,10,0,8" />
      <CheckBox x:Name="MicBox" Content="{loc:Loc SnapSharp.Core:Resources.Strings:RecordMicrophone}" /><ComboBox x:Name="MicDevices" />
      <CheckBox x:Name="SpeakerBox" Content="{loc:Loc SnapSharp.Core:Resources.Strings:RecordSystemAudioWASAPILoopback}" /><ComboBox x:Name="SpeakerDevices" />
      <CheckBox x:Name="CameraBox" Content="{loc:Loc SnapSharp.Core:Resources.Strings:CameraOverlayBottomRight}" /><ComboBox x:Name="CameraDevices" />
      <Button x:Name="RefreshButton" Content="{loc:Loc SnapSharp.Core:Resources.Strings:RefreshDevices}" Click="Refresh_Click" HorizontalAlignment="Left" />
      <TextBlock Text="{loc:Loc SnapSharp.Core:Resources.Strings:ChooseANewFileBeforeStartingThe}" TextWrapping="Wrap" Margin="0,12" Foreground="{DynamicResource TextSecondaryBrush}" />
    </StackPanel></StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,14,0,0"><DockPanel><TextBlock x:Name="ClockLabel" Text="00:00:00" FontSize="27" FontWeight="SemiBold" /><TextBlock x:Name="FrameLabel" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" /></DockPanel>
      <TextBlock x:Name="StatusLabel" Text="{loc:Loc SnapSharp.Core:Resources.Strings:Ready}" TextWrapping="Wrap" Margin="0,8" Foreground="{DynamicResource TextSecondaryBrush}" />
      <WrapPanel HorizontalAlignment="Right"><Button x:Name="StartButton" Content="{loc:Loc SnapSharp.Core:Resources.Strings:StartRecording2}" Click="Start_Click" /><Button x:Name="PauseButton" Content="{loc:Loc SnapSharp.Core:Resources.Strings:PauseResume}" IsEnabled="False" Click="Pause_Click" /><Button x:Name="StopButton" Content="{loc:Loc SnapSharp.Core:Resources.Strings:StopAndSave}" IsEnabled="False" Click="Stop_Click" /><Button x:Name="FolderButton" Content="{loc:Loc SnapSharp.Core:Resources.Strings:OpenFolder}" IsEnabled="False" Click="Folder_Click" /><Button x:Name="RecoveryButton" Content="{loc:Loc SnapSharp.Core:Resources.Strings:TemporaryFilesFromFailedRecording}" IsEnabled="False" Click="Recovery_Click" /><Button Content="{loc:Loc SnapSharp.Core:Resources.Strings:Close}" Click="Close_Click" /></WrapPanel>
    </StackPanel>
  </Grid>
</Window>
