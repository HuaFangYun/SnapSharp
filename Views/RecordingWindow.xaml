<Window x:Class="SnapSharp.Views.RecordingWindow" Style="{StaticResource AppWindow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="录制配置 · SnapSharp" Width="700" Height="740" MinWidth="620" MinHeight="540" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Window.Resources><ResourceDictionary>
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ToolbarStyles.xaml" /></ResourceDictionary.MergedDictionaries>
    <Style TargetType="Button" BasedOn="{StaticResource DialogButton}"><Setter Property="Width" Value="Auto" /><Setter Property="MinWidth" Value="90" /><Setter Property="Margin" Value="0,6,8,6" /><Setter Property="Padding" Value="12,6" /></Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource ToolbarComboBox}"><Setter Property="Margin" Value="0,6,0,14" /></Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource ToolbarTextBox}"><Setter Property="Margin" Value="0,6,0,14" /></Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource ToolbarCheckBox}"><Setter Property="Margin" Value="0,6,14,8" /></Style>
  </ResourceDictionary></Window.Resources>
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12"><TextBlock Text="区域录屏" FontSize="24" FontWeight="SemiBold" /><TextBlock x:Name="RegionLabel" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" /><Button x:Name="SetupButton" Content="检查并一键配置录屏环境…" Click="Setup_Click" HorizontalAlignment="Left" /></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock x:Name="RunningConfigurationHint" Text="录制期间可查看当前配置；停止后可修改参数。关闭配置窗口会返回悬浮工具条，录制继续。" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" Visibility="Collapsed" />
      <StackPanel x:Name="OptionsPanel">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="输出格式" /><ComboBox x:Name="FormatBox" SelectionChanged="Format_Changed"><ComboBoxItem Content="MP4（H.264 + AAC）" Tag="MP4" /><ComboBoxItem Content="GIF（无声音，最多 60 秒）" Tag="GIF" /></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="帧率（GIF 固定最多 15）" /><ComboBox x:Name="FrameRateBox"><ComboBoxItem Content="15 fps" Tag="15" /><ComboBoxItem Content="30 fps" Tag="30" /><ComboBoxItem Content="60 fps" Tag="60" /></ComboBox></StackPanel></Grid>
      <TextBlock Text="质量档位" /><ComboBox x:Name="QualityBox"><ComboBoxItem Content="流畅" /><ComboBoxItem Content="标准" /><ComboBoxItem Content="高清" /></ComboBox>
      <TextBlock Text="采集引擎（WGC 推荐；兼容问题可选择 DXGI）" /><ComboBox x:Name="CaptureBackendBox"><ComboBoxItem Content="Windows Graphics Capture" Tag="WGC" /><ComboBoxItem Content="Desktop Duplication（DXGI）" Tag="DXGI" /></ComboBox>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MP4 码率 kbps（0 按质量自动）" /><TextBox x:Name="BitrateBox" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="开始倒计时（0–10 秒）" /><TextBox x:Name="CountdownBox" /></StackPanel></Grid>
      <WrapPanel><CheckBox x:Name="HardwareBox" Content="优先硬件编码" /><CheckBox x:Name="CursorBox" Content="显示鼠标" /><CheckBox x:Name="ClicksBox" Content="点击高亮" /></WrapPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="定时停止（有效录制秒数；0 为手动）" /><TextBox x:Name="StopAfterBox" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="GIF 最长边（160–800 像素）" /><TextBox x:Name="GifEdgeBox" /></StackPanel></Grid>
      <TextBlock Text="音频与摄像头仅对本次录制生效，默认关闭" FontWeight="SemiBold" Margin="0,10,0,8" />
      <CheckBox x:Name="MicBox" Content="录制麦克风" /><ComboBox x:Name="MicDevices" />
      <CheckBox x:Name="SpeakerBox" Content="录制系统声音（WASAPI Loopback）" /><ComboBox x:Name="SpeakerDevices" />
      <CheckBox x:Name="CameraBox" Content="摄像头画中画（右下角）" /><ComboBox x:Name="CameraDevices" />
      <Button x:Name="RefreshButton" Content="刷新设备" Click="Refresh_Click" HorizontalAlignment="Left" />
      <TextBlock Text="开始前请选择新文件。启动后控制窗口最小化，可从托盘暂停、继续或停止；停止时请等待文件收尾。MP4 奇数宽高会裁去最右／最下一像素。GIF 使用抖动调色板，最多 15 fps、60 秒、100 MB。" TextWrapping="Wrap" Margin="0,12" Foreground="{DynamicResource TextSecondaryBrush}" />
    </StackPanel></StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,14,0,0"><DockPanel><TextBlock x:Name="ClockLabel" Text="00:00:00" FontSize="27" FontWeight="SemiBold" /><TextBlock x:Name="FrameLabel" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" /></DockPanel>
      <TextBlock x:Name="StatusLabel" Text="准备就绪" TextWrapping="Wrap" Margin="0,8" Foreground="{DynamicResource TextSecondaryBrush}" />
      <WrapPanel HorizontalAlignment="Right"><Button x:Name="StartButton" Content="开始录制…" Click="Start_Click" /><Button x:Name="PauseButton" Content="暂停／继续" IsEnabled="False" Click="Pause_Click" /><Button x:Name="StopButton" Content="停止并保存" IsEnabled="False" Click="Stop_Click" /><Button x:Name="FolderButton" Content="打开目录" IsEnabled="False" Click="Folder_Click" /><Button x:Name="RecoveryButton" Content="失败临时文件" IsEnabled="False" Click="Recovery_Click" /><Button Content="关闭" Click="Close_Click" /></WrapPanel>
    </StackPanel>
  </Grid>
</Window>
