<Window x:Class="SnapSharp.Views.WatermarkDialog" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="http://wpflocalizeextension.codeplex.com"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Loc SnapSharp.Core:Resources.Strings:AddWatermark}" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Resources><ResourceDictionary>
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ToolbarStyles.xaml" /></ResourceDictionary.MergedDictionaries>
    <Style TargetType="TextBox" BasedOn="{StaticResource ToolbarTextBox}" />
    <Style TargetType="CheckBox" BasedOn="{StaticResource ToolbarCheckBox}" />
    <Style TargetType="Button" BasedOn="{StaticResource DialogButton}" />
    <Style TargetType="Slider" BasedOn="{StaticResource ParameterSlider}" />
  </ResourceDictionary></Window.Resources>
  <Grid Margin="24">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="80" /><ColumnDefinition /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="44" /><RowDefinition Height="44" /><RowDefinition Height="44" /><RowDefinition Height="48" /><RowDefinition Height="52" /></Grid.RowDefinitions>
    <TextBlock Text="{loc:Loc SnapSharp.Core:Resources.Strings:WatermarkText}" VerticalAlignment="Center" Margin="0,0,12,0" />
    <TextBox x:Name="WatermarkText" Grid.Column="1" Grid.ColumnSpan="2" Text="NimCap Screenshot" VerticalAlignment="Center" />
    <TextBlock Grid.Row="1" Text="{loc:Loc SnapSharp.Core:Resources.Strings:FontSize}" VerticalAlignment="Center" Margin="0,0,12,0" />
    <Slider x:Name="FontSizeSlider" Grid.Row="1" Grid.Column="1" Minimum="12" Maximum="96" Value="28" TickFrequency="1" IsSnapToTickEnabled="True" />
    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=FontSizeSlider, StringFormat={}{0:0}}" VerticalAlignment="Center" HorizontalAlignment="Right" />
    <TextBlock Grid.Row="2" Text="{loc:Loc SnapSharp.Core:Resources.Strings:Opacity}" VerticalAlignment="Center" Margin="0,0,12,0" />
    <Slider x:Name="OpacitySlider" Grid.Row="2" Grid.Column="1" Minimum="0.05" Maximum="1" Value="0.3" />
    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:P0}}" VerticalAlignment="Center" HorizontalAlignment="Right" />
    <TextBlock Grid.Row="3" Text="{loc:Loc SnapSharp.Core:Resources.Strings:RotationAngle}" VerticalAlignment="Center" Margin="0,0,12,0" />
    <Slider x:Name="AngleSlider" Grid.Row="3" Grid.Column="1" Minimum="-90" Maximum="90" Value="-25" TickFrequency="1" IsSnapToTickEnabled="True" />
    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Value, ElementName=AngleSlider, StringFormat={}{0:0}°}" VerticalAlignment="Center" HorizontalAlignment="Right" />
    <CheckBox x:Name="TiledCheckBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Content="{loc:Loc SnapSharp.Core:Resources.Strings:TileAcrossSelection}" IsChecked="True" />
    <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
      <Button Content="{loc:Loc SnapSharp.Core:Resources.Strings:Cancel}" IsCancel="True" /><Button Content="{loc:Loc SnapSharp.Core:Resources.Strings:Add}" IsDefault="True" Click="Add_Click" Background="{DynamicResource ToolbarActiveBrush}" />
    </StackPanel>
  </Grid>
</Window>
