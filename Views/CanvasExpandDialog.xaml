<Window x:Class="NimCap.Screenshot.Views.CanvasExpandDialog" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="http://wpflocalizeextension.codeplex.com"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ExpandCanvas}" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
  <Window.Resources><ResourceDictionary>
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ToolbarStyles.xaml" /></ResourceDictionary.MergedDictionaries>
    <Style TargetType="TextBox" BasedOn="{StaticResource ToolbarTextBox}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource ToolbarComboBox}" />
    <Style TargetType="Button" BasedOn="{StaticResource DialogButton}" />
  </ResourceDictionary></Window.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
    <TextBlock Grid.Row="0" Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Width}" Margin="0,0,12,10" VerticalAlignment="Center"/>
    <TextBox x:Name="WidthBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>
    <TextBlock Grid.Row="1" Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Height}" Margin="0,0,12,10" VerticalAlignment="Center"/>
    <TextBox x:Name="HeightBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"/>
    <TextBlock Grid.Row="2" Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:OriginalImagePosition}" Margin="0,0,12,10" VerticalAlignment="Center"/>
    <ComboBox x:Name="PositionBox" Grid.Row="2" Grid.Column="1" SelectedIndex="4" Margin="0,0,0,10">
      <ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:TopLeft}" Tag="TopLeft"/><ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:TopCenter}" Tag="Top"/><ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:TopRight}" Tag="TopRight"/>
      <ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:MiddleLeft}" Tag="Left"/><ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Center}" Tag="Center"/><ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:MiddleRight}" Tag="Right"/>
      <ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:BottomLeft}" Tag="BottomLeft"/><ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:BottomCenter}" Tag="Bottom"/><ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:BottomRight}" Tag="BottomRight"/>
    </ComboBox>
    <TextBlock Grid.Row="3" Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:BackgroundColor}" Margin="0,0,12,14" VerticalAlignment="Center"/>
    <Button x:Name="ColorButton" Grid.Row="3" Grid.Column="1" Content="#FFFFFFFF" Click="Color_Click" Margin="0,0,0,14"/>
    <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Cancel}" Width="76" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:OK}" Width="76" IsDefault="True" Click="Ok_Click"/>
    </StackPanel>
  </Grid>
</Window>
