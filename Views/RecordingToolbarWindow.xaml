<Window x:Class="SnapSharp.Views.RecordingToolbarWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="录屏工具条" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True" SizeToContent="WidthAndHeight">
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="⠿" FontSize="22" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,10,0" VerticalAlignment="Center" Cursor="SizeAll" MouseLeftButtonDown="Drag_MouseDown" ToolTip="拖动工具条（不改变录制区域）" />
      <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="{DynamicResource ToolbarActiveBrush}" Margin="0,0,8,0" />
      <StackPanel Margin="0,0,12,0" MinWidth="115" VerticalAlignment="Center">
        <TextBlock x:Name="Clock" Text="00:00:00" FontFamily="Consolas" FontSize="17" />
        <TextBlock x:Name="StateText" Text="准备录制" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>
      <Button x:Name="RecordButton" Style="{StaticResource ToolbarButton}" Click="Record_Click" ToolTip="开始录制"><icons:PackIconLucide Kind="Circle" Foreground="#FF6259" /></Button>
      <Button x:Name="PauseButton" Style="{StaticResource ToolbarButton}" Click="Pause_Click" ToolTip="暂停／继续" IsEnabled="False"><icons:PackIconLucide x:Name="PauseIcon" Kind="Pause" /></Button>
      <Button x:Name="StopButton" Style="{StaticResource ToolbarButton}" Click="Stop_Click" ToolTip="停止并保存" IsEnabled="False"><icons:PackIconLucide Kind="Square" /></Button>
      <Separator Style="{StaticResource ToolbarSeparator}" />
      <Button x:Name="ConfigurationButton" Style="{StaticResource ToolbarButton}" Click="Configuration_Click" ToolTip="录制配置"><icons:PackIconLucide Kind="Settings" /></Button>
      <Button Style="{StaticResource ToolbarButton}" Click="Hide_Click" ToolTip="收起工具条（从托盘录屏菜单恢复）"><icons:PackIconLucide Kind="Minus" /></Button>
      <Button x:Name="CloseButton" Style="{StaticResource ToolbarButton}" Click="Close_Click" ToolTip="关闭录屏"><icons:PackIconLucide Kind="X" /></Button>
    </StackPanel>
    </Viewbox>
  </Border>
</Window>
