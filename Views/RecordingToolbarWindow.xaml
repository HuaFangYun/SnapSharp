<Window x:Class="SnapSharp.Views.RecordingToolbarWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="http://wpflocalizeextension.codeplex.com"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="{loc:Loc SnapSharp.Core:Resources.Strings:RecordingToolbar}" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True" SizeToContent="WidthAndHeight">
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="⠿" FontSize="22" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,10,0" VerticalAlignment="Center" Cursor="SizeAll" MouseLeftButtonDown="Drag_MouseDown" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:DragToolbarRecordingRegionStaysFixed}" />
      <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="{DynamicResource ToolbarActiveBrush}" Margin="0,0,8,0" />
      <StackPanel Margin="0,0,12,0" MinWidth="115" VerticalAlignment="Center">
        <TextBlock x:Name="Clock" Text="00:00:00" FontFamily="Consolas" FontSize="17" />
        <TextBlock x:Name="StateText" Text="{loc:Loc SnapSharp.Core:Resources.Strings:ReadyToRecord}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>
      <Button x:Name="RecordButton" Style="{StaticResource ToolbarButton}" Click="Record_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:StartRecording}"><icons:PackIconLucide Kind="Circle" Foreground="#FF6259" /></Button>
      <Button x:Name="PauseButton" Style="{StaticResource ToolbarButton}" Click="Pause_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:PauseResume}" IsEnabled="False"><icons:PackIconLucide x:Name="PauseIcon" Kind="Pause" /></Button>
      <Button x:Name="StopButton" Style="{StaticResource ToolbarButton}" Click="Stop_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:StopAndSave}" IsEnabled="False"><icons:PackIconLucide Kind="Square" /></Button>
      <Separator Style="{StaticResource ToolbarSeparator}" />
      <Button x:Name="ConfigurationButton" Style="{StaticResource ToolbarButton}" Click="Configuration_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:RecordingOptions}"><icons:PackIconLucide Kind="Settings" /></Button>
      <Button Style="{StaticResource ToolbarButton}" Click="Hide_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:HideToolbarRestoreFromTrayRecordingMenu}"><icons:PackIconLucide Kind="Minus" /></Button>
      <Button x:Name="CloseButton" Style="{StaticResource ToolbarButton}" Click="Close_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:CloseRecording}"><icons:PackIconLucide Kind="X" /></Button>
    </StackPanel>
    </Viewbox>
  </Border>
</Window>
