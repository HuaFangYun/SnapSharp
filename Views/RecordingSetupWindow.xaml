<Window x:Class="SnapSharp.Views.RecordingSetupWindow" Style="{StaticResource AppWindow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="一键配置录屏环境 · SnapSharp" Width="660" Height="610" MinWidth="520" MinHeight="420" WindowStartupLocation="CenterOwner" Closing="Window_Closing">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ToolbarStyles.xaml" /></ResourceDictionary.MergedDictionaries>
    <Style TargetType="Button" BasedOn="{StaticResource DialogButton}"><Setter Property="Width" Value="Auto" /><Setter Property="Margin" Value="0,5,8,5" /><Setter Property="Padding" Value="12,7" /></Style>
  </ResourceDictionary></Window.Resources>
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="录屏环境" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="一次检查，补齐缺失组件。已安装的组件不会重复下载。" TextWrapping="Wrap" Margin="0,10,0,16" /></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock x:Name="EnvironmentStatus" TextWrapping="Wrap" Margin="0,0,0,16" />
      <TextBlock Text="点击一键配置后，缺失的 Visual C++ x64 从微软官方源下载，并验证 Windows 信任签名和微软发布者后安装。Windows N/KN 缺少媒体组件时，由 Windows 下载并安装匹配版本的 Media Feature Pack。安装需确认系统管理员授权（UAC）；可能要求重启，程序不会自动重启电脑。" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
      <WrapPanel Margin="0,12"><Button x:Name="ConfigureButton" Content="一键检查并安装缺失组件" Click="Configure_Click" /><Button x:Name="CancelDownloadButton" Content="取消下载" Click="Cancel_Click" IsEnabled="False" /><Button x:Name="RefreshButton" Content="重新检查" Click="Refresh_Click" /></WrapPanel>
      <TextBlock x:Name="SetupStatus" Text="首次使用建议先检查，再选择录屏参数。配置完成后用生成的测试图实际验证 MP4 编码，不录制屏幕、不打开麦克风／摄像头。" TextWrapping="Wrap" Margin="0,0,0,16" />
      <TextBlock Text="设备权限与系统修复" FontWeight="SemiBold" />
      <WrapPanel><Button Content="麦克风访问权限" Tag="ms-settings:privacy-microphone" Click="SystemSettings_Click" /><Button Content="摄像头访问权限" Tag="ms-settings:privacy-webcam" Click="SystemSettings_Click" /><Button Content="Windows 可选功能" Tag="ms-settings:optionalfeatures" Click="SystemSettings_Click" /></WrapPanel>
      <TextBlock Text="设备权限由 Windows 管理，需开启“允许桌面应用访问”。Windows Server 或裁剪系统的媒体组件可能需要管理员修复；这里会显示具体缺失项。录屏引擎、GIF 编码器已内置，无需另外下载 FFmpeg 或 NuGet。" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
    </StackPanel></ScrollViewer>
    <Button Grid.Row="2" Content="关闭" Click="Close_Click" HorizontalAlignment="Right" />
  </Grid>
</Window>
