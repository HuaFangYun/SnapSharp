<Window x:Class="SnapSharp.Views.RecognitionWindow" Style="{StaticResource AppWindow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="http://wpflocalizeextension.codeplex.com"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="{loc:Loc SnapSharp.Core:Resources.Strings:OCRRecognitionBackgroundRemovalSnapSharp}" Width="1240" Height="790" MinWidth="980" MinHeight="560" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Window.Resources><ResourceDictionary>
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ToolbarStyles.xaml" /></ResourceDictionary.MergedDictionaries>
    <Style TargetType="Button" BasedOn="{StaticResource DialogButton}"><Setter Property="Width" Value="Auto" /><Setter Property="Padding" Value="12,5" /><Setter Property="Margin" Value="0,4,6,4" /></Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource ToolbarComboBox}" />
    <Style x:Key="RecognitionNavigation" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
        <!-- Own the disabled state: the Windows ListBox template paints a light system background. -->
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ScrollViewer Focusable="False" CanContentScroll="True"
                        HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                        VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
            <ItemsPresenter />
          </ScrollViewer>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="RecognitionNavigationItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="12,14" /><Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Surface" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter /></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlHoverBrush}" /></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ToolbarActiveBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" /></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ToolbarActiveBrush}" /><Setter TargetName="Surface" Property="BorderThickness" Value="1" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.75" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Padding="10,9" CornerRadius="6,6,0,0" Background="{DynamicResource SurfaceAltBrush}"><ContentPresenter ContentSource="Header" /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource ToolbarActiveBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}" /><Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAltBrush}" /><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="HeadersVisibility" Value="Column" />
    </Style>
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppGridColumnHeader}"><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /></Style>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="4" /><Setter Property="BorderThickness" Value="0" /><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ToolbarActiveBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" /></Trigger></Style.Triggers></Style>
    <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#EEE" Geometry="M0,0 H16 V16 H0 Z" /><GeometryDrawing Brush="#CCC" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z" /></DrawingGroup></DrawingBrush.Drawing></DrawingBrush>
  </ResourceDictionary></Window.Resources>
  <Grid Margin="18">
    <Grid.ColumnDefinitions><ColumnDefinition Width="168" /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{loc:Loc SnapSharp.Core:Resources.Strings:RecognitionLocalHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,16,8,8" FontSize="12" />
        <ListBox x:Name="ModeBox" Style="{StaticResource RecognitionNavigation}" ItemContainerStyle="{StaticResource RecognitionNavigationItem}">
          <ListBoxItem Tag="OCR"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions><icons:PackIconLucide Kind="ScanText" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="{loc:Loc SnapSharp.Core:Resources.Strings:TextOCR}" TextWrapping="Wrap" /></Grid></ListBoxItem>
          <ListBoxItem Tag="Document"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions><icons:PackIconLucide Kind="IdCard" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="{loc:Loc SnapSharp.Core:Resources.Strings:IdentityDocuments}" TextWrapping="Wrap" /></Grid></ListBoxItem>
          <ListBoxItem Tag="Table"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions><icons:PackIconLucide Kind="Table" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="{loc:Loc SnapSharp.Core:Resources.Strings:RecognitionTableTool}" TextWrapping="Wrap" /></Grid></ListBoxItem>
          <ListBoxItem Tag="Barcode"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions><icons:PackIconLucide Kind="QrCode" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="{loc:Loc SnapSharp.Core:Resources.Strings:QRBarcodes}" TextWrapping="Wrap" /></Grid></ListBoxItem>
          <ListBoxItem Tag="Formula"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions><icons:PackIconLucide Kind="Sigma" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="{loc:Loc SnapSharp.Core:Resources.Strings:RecognitionFormulaTool}" TextWrapping="Wrap" /></Grid></ListBoxItem>
          <ListBoxItem Tag="Cutout"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions><icons:PackIconLucide Kind="Scissors" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="{loc:Loc SnapSharp.Core:Resources.Strings:RecognitionCutoutTool}" TextWrapping="Wrap" /></Grid></ListBoxItem>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,12">
      <ComboBox x:Name="CutoutModelBox" Width="310" Margin="0,4,12,4" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:ChooseAModelThenRemoveTheBackground}" />
      <Button x:Name="RunButton" Content="{loc:Loc SnapSharp.Core:Resources.Strings:StartRunAgain}" Click="Run_Click" Background="{DynamicResource ToolbarActiveBrush}" Foreground="{DynamicResource AccentForegroundBrush}" />
      <Button x:Name="CancelButton" Content="{loc:Loc SnapSharp.Core:Resources.Strings:Stop}" Click="Cancel_Click" IsEnabled="False" /><Button Content="{loc:Loc SnapSharp.Core:Resources.Strings:SetUpChangeEngine}" Click="Settings_Click" />
    </WrapPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <WrapPanel x:Name="ImageTransformTools" Margin="0,0,0,6">
          <Button Content="{loc:Loc SnapSharp.Core:Resources.Strings:RecognitionRotateLeft}" Tag="Left" Click="TransformImage_Click" />
          <Button Content="{loc:Loc SnapSharp.Core:Resources.Strings:RecognitionRotateRight}" Tag="Right" Click="TransformImage_Click" />
          <Button Content="{loc:Loc SnapSharp.Core:Resources.Strings:RecognitionRotateHalf}" Tag="Half" Click="TransformImage_Click" />
          <Button Content="{loc:Loc SnapSharp.Core:Resources.Strings:RecognitionFlipVertical}" Tag="Vertical" Click="TransformImage_Click" />
        </WrapPanel>
        <Border Grid.Row="1" Background="{StaticResource Checker}" CornerRadius="8" Padding="4">
          <ScrollViewer x:Name="PictureScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                        CanContentScroll="False" PanningMode="None" Background="Transparent"
                        ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:RecognitionPreviewHint}"
                        PreviewMouseWheel="Picture_MouseWheel" PreviewMouseDown="Picture_MouseDown"
                        PreviewMouseMove="Picture_MouseMove" PreviewMouseUp="Picture_MouseUp"
                        LostMouseCapture="Picture_LostMouseCapture">
            <Grid x:Name="PictureCanvas" HorizontalAlignment="Left" VerticalAlignment="Top">
              <Grid.LayoutTransform><ScaleTransform x:Name="PictureScale" ScaleX="0.5" ScaleY="0.5" /></Grid.LayoutTransform>
              <Image x:Name="Picture" Stretch="Fill" />
            </Grid>
          </ScrollViewer>
        </Border>
        <CheckBox x:Name="ShowOriginal" Visibility="Collapsed" Grid.Row="2" Content="{loc:Loc SnapSharp.Core:Resources.Strings:ViewOriginalBackgroundRemoval}" Checked="Original_Changed" Unchecked="Original_Changed" Margin="0,10" />
      </Grid>
      <TabControl x:Name="ResultTabs" Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}">
        <TabItem x:Name="TextResultTab" Header="{loc:Loc SnapSharp.Core:Resources.Strings:TextBarcodes}"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,8">
            <ComboBox x:Name="TargetLanguageBox" Width="190" SelectionChanged="TargetLanguage_Changed" />
            <Button x:Name="TranslateButton" Content="{loc:Loc SnapSharp.Core:Resources.Strings:Translate}" Click="Translate_Click" />
            <ComboBox x:Name="TextViewBox" Width="100" SelectionChanged="TextView_Changed">
              <ComboBoxItem Content="{loc:Loc SnapSharp.Core:Resources.Strings:SourceText}" Tag="Source" />
              <ComboBoxItem Content="{loc:Loc SnapSharp.Core:Resources.Strings:TranslatedTextView}" Tag="Translation" />
              <ComboBoxItem Content="{loc:Loc SnapSharp.Core:Resources.Strings:BilingualText}" Tag="Bilingual" />
            </ComboBox>
          </WrapPanel>
          <TextBox x:Name="TextEditor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" FontSize="16" TextChanged="Text_Changed" />
          <WrapPanel Grid.Row="2" Margin="0,6,0,0"><Button Content="{loc:Loc SnapSharp.Core:Resources.Strings:CopyText}" Click="CopyText_Click" /><Button Content="{loc:Loc SnapSharp.Core:Resources.Strings:ExportText}" Click="ExportText_Click" /><Button Content="{loc:Loc SnapSharp.Core:Resources.Strings:TranslationSettings}" Click="TranslationSettings_Click" /></WrapPanel>
        </Grid></TabItem>
        <TabItem x:Name="TableResultTab" Header="{loc:Loc SnapSharp.Core:Resources.Strings:TableCorrection}"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <TextBlock Text="{loc:Loc SnapSharp.Core:Resources.Strings:TableModeUsesLocalSLANetStructureRecognition}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
          <DataGrid x:Name="CellsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="True"><DataGrid.Columns>
            <DataGridTextColumn Header="{loc:Loc SnapSharp.Core:Resources.Strings:Row}" Binding="{Binding Row}" Width="SizeToHeader" MinWidth="40" /><DataGridTextColumn Header="{loc:Loc SnapSharp.Core:Resources.Strings:Column}" Binding="{Binding Column}" Width="SizeToHeader" MinWidth="40" /><DataGridTextColumn Header="{loc:Loc SnapSharp.Core:Resources.Strings:RowSpan}" Binding="{Binding RowSpan}" Width="SizeToHeader" MinWidth="45" /><DataGridTextColumn Header="{loc:Loc SnapSharp.Core:Resources.Strings:ColumnSpan}" Binding="{Binding ColumnSpan}" Width="SizeToHeader" MinWidth="45" /><DataGridTextColumn Header="{loc:Loc SnapSharp.Core:Resources.Strings:Text2}" Binding="{Binding Text}" Width="*" />
          </DataGrid.Columns></DataGrid>
          <WrapPanel Grid.Row="2"><Button Content="{loc:Loc SnapSharp.Core:Resources.Strings:ExportCSV}" Tag="csv" Click="ExportTable_Click" /><Button Content="{loc:Loc SnapSharp.Core:Resources.Strings:ExportXLSX}" Tag="xlsx" Click="ExportTable_Click" /></WrapPanel>
        </Grid></TabItem>
        <TabItem x:Name="CutoutResultTab" Header="{loc:Loc SnapSharp.Core:Resources.Strings:BackgroundRemovalOutput}"><StackPanel Margin="16"><TextBlock Text="{loc:Loc SnapSharp.Core:Resources.Strings:TheCheckerboardIndicatesTransparencyCheckHairTranslucent}" TextWrapping="Wrap" Margin="0,0,0,16" />
          <WrapPanel x:Name="CutoutButtons" IsEnabled="False"><Button Content="{loc:Loc SnapSharp.Core:Resources.Strings:CopyImage}" Tag="Copy" Click="CutoutOutput_Click" /><Button Content="{loc:Loc SnapSharp.Core:Resources.Strings:SaveImage}" Tag="Save" Click="CutoutOutput_Click" /><Button Content="{loc:Loc SnapSharp.Core:Resources.Strings:PinImage}" Tag="Pin" Click="CutoutOutput_Click" /></WrapPanel>
          <TextBlock Text="{loc:Loc SnapSharp.Core:Resources.Strings:PNGIsSelectedByDefaultJPEGBMP}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12" />
        </StackPanel></TabItem>
        <TabItem x:Name="DocumentResultTab" Header="{loc:Loc SnapSharp.Core:Resources.Strings:IdentityFields}" Visibility="Collapsed">
          <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8"><Button x:Name="ChangeDocumentTypeButton" DockPanel.Dock="Right" Content="{loc:Loc SnapSharp.Core:Resources.Strings:ChangeDocumentType}" Click="ChangeDocumentType_Click" /><TextBlock x:Name="DocumentTypeText" Text="{loc:Loc SnapSharp.Core:Resources.Strings:DocumentUnknown}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
            <TextBlock Grid.Row="1" Text="{loc:Loc SnapSharp.Core:Resources.Strings:DocumentFieldsHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
            <TextBox x:Name="DocumentEditor" Grid.Row="2" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" FontSize="16" SelectionChanged="DocumentText_Selected" />
            <WrapPanel Grid.Row="3" Margin="0,6,0,0"><Button Content="{loc:Loc SnapSharp.Core:Resources.Strings:CopyText}" Click="CopyDocument_Click" /><Button Content="{loc:Loc SnapSharp.Core:Resources.Strings:ExportText}" Click="ExportDocument_Click" /></WrapPanel>
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>
    <DockPanel Grid.Row="2" Margin="0,12,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="{loc:Loc SnapSharp.Core:Resources.Strings:ImageSearch}" Click="Search_Click" /><Button Content="{loc:Loc SnapSharp.Core:Resources.Strings:Close}" Click="Close_Click" /></StackPanel><TextBlock x:Name="Status" Text="{loc:Loc SnapSharp.Core:Resources.Strings:Ready}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" /></DockPanel>
    </Grid>
  </Grid>
</Window>
