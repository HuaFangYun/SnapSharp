<Window x:Class="NimCap.Screenshot.Views.RecognitionWindow" Style="{StaticResource AppWindow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="http://wpflocalizeextension.codeplex.com"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ImageToolsWindowTitle}" Width="1240" Height="790" MinWidth="980" MinHeight="560" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Window.Resources><ResourceDictionary>
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ToolbarStyles.xaml" /></ResourceDictionary.MergedDictionaries>
    <Style TargetType="Button" BasedOn="{StaticResource DialogButton}"><Setter Property="Width" Value="Auto" /><Setter Property="Padding" Value="7,2" /><Setter Property="Margin" Value="0,2,4,2" /><Setter Property="Height" Value="26" /><Setter Property="MinWidth" Value="0" /><Setter Property="FontSize" Value="12" /></Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource ToolbarComboBox}"><Setter Property="Height" Value="26" /><Setter Property="MinHeight" Value="26" /><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="6,2" /></Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="FontSize" Value="12" /><Setter Property="MinHeight" Value="22" /></Style>
    <Style x:Key="RecognitionNavigation" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
        <!-- Own the disabled state: the Windows ListBox template paints a light system background. -->
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ScrollViewer Focusable="False" CanContentScroll="True"
                        HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                        VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
            <ItemsPresenter />
          </ScrollViewer>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="RecognitionNavigationItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="8,9" /><Setter Property="Margin" Value="0,0,0,3" /><Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Surface" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter /></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlHoverBrush}" /></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ToolbarActiveBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" /></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ToolbarActiveBrush}" /><Setter TargetName="Surface" Property="BorderThickness" Value="1" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.75" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Padding="8,5" CornerRadius="6,6,0,0" Background="{DynamicResource SurfaceAltBrush}"><ContentPresenter ContentSource="Header" /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource ToolbarActiveBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}" /><Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAltBrush}" /><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="HeadersVisibility" Value="Column" />
    </Style>
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppGridColumnHeader}"><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /></Style>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="4" /><Setter Property="BorderThickness" Value="0" /><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ToolbarActiveBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" /></Trigger></Style.Triggers></Style>
    <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#EEE" Geometry="M0,0 H16 V16 H0 Z" /><GeometryDrawing Brush="#CCC" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z" /></DrawingGroup></DrawingBrush.Drawing></DrawingBrush>
  </ResourceDictionary></Window.Resources>
  <Grid Margin="10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="132" MaxWidth="220" /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="8">
      <DockPanel>
        <ListBox x:Name="ModeBox" Style="{StaticResource RecognitionNavigation}" ItemContainerStyle="{StaticResource RecognitionNavigationItem}">
          <ListBoxItem Tag="OCR"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition /></Grid.ColumnDefinitions><icons:PackIconLucide Kind="ScanText" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:TextOCR}" TextWrapping="NoWrap" /></Grid></ListBoxItem>
          <ListBoxItem Tag="Summary"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition /></Grid.ColumnDefinitions><icons:PackIconLucide Kind="List" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:CaptureSummary}" TextWrapping="NoWrap" /></Grid></ListBoxItem>
          <ListBoxItem Tag="Document"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition /></Grid.ColumnDefinitions><icons:PackIconLucide Kind="IdCard" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:IdentityDocuments}" TextWrapping="NoWrap" /></Grid></ListBoxItem>
          <ListBoxItem Tag="Table"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition /></Grid.ColumnDefinitions><icons:PackIconLucide Kind="Table" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionTableTool}" TextWrapping="NoWrap" /></Grid></ListBoxItem>
          <ListBoxItem Tag="Barcode"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition /></Grid.ColumnDefinitions><icons:PackIconLucide Kind="QrCode" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionBarcodeNavigation}" TextWrapping="NoWrap" /></Grid></ListBoxItem>
          <ListBoxItem Tag="Formula"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition /></Grid.ColumnDefinitions><icons:PackIconLucide Kind="Sigma" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionFormulaTool}" TextWrapping="NoWrap" /></Grid></ListBoxItem>
          <ListBoxItem Tag="Cutout"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition /></Grid.ColumnDefinitions><icons:PackIconLucide Kind="Scissors" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionCutoutTool}" TextWrapping="NoWrap" /></Grid></ListBoxItem>
          <ListBoxItem Tag="Watermark"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition /></Grid.ColumnDefinitions><icons:PackIconLucide Kind="Eraser" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:WatermarkRemoval}" TextWrapping="NoWrap" /></Grid></ListBoxItem>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid x:Name="ModelToolbar" Margin="0,0,0,6">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="ModelNameColumn" /><ColumnDefinition x:Name="ModelDeviceColumn" Width="122" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Grid Margin="0,0,6,0">
        <ComboBox x:Name="QuickModelBox" SelectionChanged="QuickModel_Changed" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionModelLabel}" />
        <ComboBox x:Name="CutoutModelBox" Visibility="Collapsed" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ChooseAModelThenRemoveTheBackground}" />
        <ComboBox x:Name="WatermarkModelBox" Visibility="Collapsed" SelectionChanged="WatermarkModel_Changed"><ComboBox.ToolTip><TextBlock x:Name="WatermarkModelStatus" /></ComboBox.ToolTip></ComboBox>
      </Grid>
      <Grid Grid.Column="1" Margin="0,0,6,0">
        <ComboBox x:Name="ProcessingDeviceBox" SelectedValuePath="Tag" SelectionChanged="ProcessingDevice_Changed" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:WatermarkDeviceLabel}"><ComboBoxItem Tag="CPU" Content="CPU" /><ComboBoxItem Tag="DirectML" Content="DirectML GPU" /><ComboBoxItem Tag="Plugin" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionPluginDevice}" /></ComboBox>
        <ComboBox x:Name="WatermarkDeviceBox" Visibility="Collapsed" SelectedValuePath="Tag" SelectedValue="CPU" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:WatermarkDeviceLabel}"><ComboBoxItem Tag="CPU" Content="CPU" /><ComboBoxItem Tag="DirectML" Content="DirectML GPU" /></ComboBox>
      </Grid>
      <Button Grid.Column="2" x:Name="EngineSettingsButton" Click="Settings_Click" Width="28" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:SetUpChangeEngine}" AutomationProperties.Name="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:SetUpChangeEngine}" Margin="0,2,0,2"><icons:PackIconLucide Kind="Settings" Width="14" Height="14" /></Button>
    </Grid>
    <Grid x:Name="WorkspaceGrid" Grid.Row="1"><Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition x:Name="PreviewColumn" Width="1.2*" /><ColumnDefinition x:Name="WorkspaceGap" Width="10" /><ColumnDefinition x:Name="ResultColumn" Width="*" /></Grid.ColumnDefinitions>
      <GridSplitter x:Name="ResultSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock x:Name="SourcePreviewHeader" Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionOriginalImage}" Visibility="Collapsed" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
        <Border Grid.Row="1" Background="{StaticResource Checker}" CornerRadius="8" Padding="4">
          <ScrollViewer x:Name="PictureScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                        CanContentScroll="False" PanningMode="None" Background="Transparent"
                        ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionPreviewHint}"
                        PreviewMouseWheel="Picture_MouseWheel" PreviewMouseDown="Picture_MouseDown"
                        PreviewMouseMove="Picture_MouseMove" PreviewMouseUp="Picture_MouseUp"
                        LostMouseCapture="Picture_LostMouseCapture" MouseLeave="Picture_MouseLeave" ScrollChanged="Comparison_ScrollChanged">
            <Grid x:Name="PictureCanvas" HorizontalAlignment="Left" VerticalAlignment="Top">
              <Grid.LayoutTransform><ScaleTransform x:Name="PictureScale" ScaleX="0.5" ScaleY="0.5" /></Grid.LayoutTransform>
              <Image x:Name="Picture" Stretch="Fill" />
              <Image x:Name="WatermarkOverlay" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed" />
              <Rectangle x:Name="WatermarkRegionOutline" Stroke="White" StrokeDashArray="4,4" StrokeThickness="2" Fill="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed">
                <Rectangle.Effect><DropShadowEffect Color="Black" BlurRadius="1" ShadowDepth="0" Opacity="1" /></Rectangle.Effect><Rectangle.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset" From="0" To="8" Duration="0:0:0.6" /></Storyboard></BeginStoryboard></EventTrigger></Rectangle.Triggers>
              </Rectangle>
              <Ellipse x:Name="WatermarkBrushCursor" Stroke="White" Fill="#10000000" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed"><Ellipse.Effect><DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="0" /></Ellipse.Effect></Ellipse>
            </Grid>
          </ScrollViewer>
        </Border>
      </Grid>
        <Grid x:Name="ImageTools" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,4,0,0" SizeChanged="ImageTools_SizeChanged">
          <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="30" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" x:Name="ImageTransformTools" Grid.ColumnSpan="3" Margin="0,0,8,0">
          <Button ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionRotateLeft}" AutomationProperties.Name="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionRotateLeft}" Width="28" Tag="Left" Click="TransformImage_Click"><icons:PackIconLucide Kind="RotateCcw" Width="14" Height="14" /></Button>
          <Button ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionRotateRight}" AutomationProperties.Name="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionRotateRight}" Width="28" Tag="Right" Click="TransformImage_Click"><icons:PackIconLucide Kind="RotateCw" Width="14" Height="14" /></Button>
          <Button Content="180°" FontSize="10" Padding="2" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionRotateHalf}" AutomationProperties.Name="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionRotateHalf}" Width="30" Tag="Half" Click="TransformImage_Click" />
          <Button Content="↕" FontSize="16" Padding="2" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionFlipVertical}" AutomationProperties.Name="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionFlipVertical}" Width="28" Tag="Vertical" Click="TransformImage_Click" />
        </StackPanel>
          <ScrollViewer x:Name="ParameterScroll" Grid.Row="1" Grid.ColumnSpan="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" Margin="0,0,6,0">
            <StackPanel x:Name="WatermarkPreviewActions" Orientation="Horizontal" Visibility="Collapsed">
              <ComboBox x:Name="WatermarkMethod" Width="116" Margin="0,2,8,2" SelectedIndex="0" SelectionChanged="WatermarkMethod_Changed"><ComboBoxItem Tag="Brush" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:WatermarkBrushMode}" /><ComboBoxItem Tag="Region" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:WatermarkRegionMode}" /><ComboBoxItem Tag="Smart" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:WatermarkSmartMode}" /></ComboBox>
              <Button x:Name="WatermarkMoreButton" Width="28" Content="…" Visibility="Collapsed" Click="WatermarkMore_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:WatermarkBrushSize}" />
              <Popup x:Name="WatermarkMorePopup" PlacementTarget="{Binding ElementName=WatermarkMoreButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                  <StackPanel>
                    <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:WatermarkBrushSize}" Foreground="{DynamicResource TextBrush}" />
                    <Slider Style="{StaticResource ParameterSlider}" Width="180" Minimum="2" Maximum="256" Value="{Binding Value, ElementName=WatermarkBrushSize, Mode=TwoWay}" Margin="0,8" />
                    <CheckBox Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:WatermarkEraseMask}" IsChecked="{Binding IsChecked, ElementName=WatermarkErase, Mode=TwoWay}" />
                  </StackPanel>
                </Border>
              </Popup>
              <StackPanel x:Name="WatermarkMaskTools" Orientation="Horizontal">
              <Slider x:Name="WatermarkBrushSize" Style="{StaticResource ParameterSlider}" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:WatermarkBrushSize}" Width="76" Minimum="2" Maximum="256" Value="32" VerticalAlignment="Center" Margin="0,0,4,0" ValueChanged="WatermarkBrushSize_Changed" />
              <TextBlock Text="{Binding Value, ElementName=WatermarkBrushSize, StringFormat={}{0:F0}}" MinWidth="22" FontSize="11" VerticalAlignment="Center" />
              <CheckBox x:Name="WatermarkErase" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:WatermarkEraseMask}" VerticalAlignment="Center" Margin="4,2" />
            </StackPanel>
              <StackPanel x:Name="WatermarkHistoryActions" Orientation="Horizontal">
                <Button x:Name="WatermarkUndoButton" Width="28" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:WatermarkUndoMask}" AutomationProperties.Name="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:WatermarkUndoMask}" Click="WatermarkUndo_Click" ><icons:PackIconLucide Kind="Undo2" Width="14" Height="14" /></Button>
                <Button Width="28" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:WatermarkClearMask}" AutomationProperties.Name="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:WatermarkClearMask}" Click="WatermarkClear_Click" ><icons:PackIconLucide Kind="Trash2" Width="14" Height="14" /></Button>
                <ToggleButton x:Name="WatermarkShowMask" Style="{StaticResource ToolbarFieldToggle}" Width="28" Height="26" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionShowMask}" AutomationProperties.Name="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionShowMask}" IsChecked="True" Checked="WatermarkMaskVisibility_Changed" Unchecked="WatermarkMaskVisibility_Changed" VerticalAlignment="Center" Margin="0,2,4,2" ><icons:PackIconLucide Kind="Eye" Width="14" Height="14" /></ToggleButton>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <Grid x:Name="CommonProcessingActions" Grid.Row="1" Grid.Column="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="56" /><ColumnDefinition Width="32" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="RunButton" Width="136" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionRunCompact}" Click="Run_Click" Background="{DynamicResource ToolbarActiveBrush}" Foreground="{DynamicResource AccentForegroundBrush}" />
      <Button Grid.Column="1" x:Name="CancelButton" Width="52" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Stop}" Click="Cancel_Click" IsEnabled="False" />
            <Button Grid.Column="2" x:Name="CommonUndoButton" Width="28" Click="CommonUndo_Click" IsEnabled="False" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionUndoAction}" AutomationProperties.Name="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionUndoAction}"><icons:PackIconLucide Kind="Undo2" Width="14" Height="14" /></Button>
          <StackPanel Grid.Column="3" Orientation="Horizontal">      <Button x:Name="CommonCopyButton" Width="28" Click="CommonCopy_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionCopyResult}" AutomationProperties.Name="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionCopyResult}"><icons:PackIconLucide Kind="Copy" Width="14" Height="14" /></Button>
      <Button x:Name="CommonExportButton" Width="28" Click="CommonExport_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionSaveResult}" AutomationProperties.Name="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionSaveResult}">
        <Button.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ExportCSV}" Tag="csv" Click="ExportTable_Click" /><MenuItem Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ExportXLSX}" Tag="xlsx" Click="ExportTable_Click" /></ContextMenu></Button.ContextMenu>
        <icons:PackIconLucide Kind="Save" Width="14" Height="14" />
      </Button>
      <Button x:Name="CommonPinButton" Width="28" Click="CommonPin_Click" ToolTip="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:PinImage}" AutomationProperties.Name="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:PinImage}" Margin="0,2,0,2"><icons:PackIconLucide Kind="Pin" Width="14" Height="14" /></Button></StackPanel></Grid>
        </Grid>
      <TextBlock x:Name="WatermarkDetectorStatus" Visibility="Collapsed" />
      <Grid x:Name="ComparisonPanel" Grid.Column="2" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionProcessedImage}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
        <Border Grid.Row="1" Background="{StaticResource Checker}" CornerRadius="6" Padding="4">
          <Grid>
            <ScrollViewer x:Name="ComparisonScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False" PanningMode="None" ScrollChanged="Comparison_ScrollChanged" PreviewMouseWheel="Comparison_MouseWheel" PreviewMouseDown="Comparison_MouseDown" PreviewMouseMove="Comparison_MouseMove" PreviewMouseUp="Comparison_MouseUp" LostMouseCapture="Comparison_LostMouseCapture">
              <Grid x:Name="ComparisonCanvas" HorizontalAlignment="Left" VerticalAlignment="Top"><Grid.LayoutTransform><ScaleTransform x:Name="ComparisonScale" ScaleX="{Binding ScaleX, ElementName=PictureScale}" ScaleY="{Binding ScaleY, ElementName=PictureScale}" /></Grid.LayoutTransform><Image x:Name="ComparisonImage" Stretch="Fill" /></Grid>
            </ScrollViewer>
            <TextBlock x:Name="ComparisonPlaceholder" Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionResultPlaceholder}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Foreground="#FF333333" Background="#DDEEEEEE" Padding="10,5" Margin="12" IsHitTestVisible="False" />
          </Grid>
        </Border>
      </Grid>
      <TabControl x:Name="ResultTabs" Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}">
        <TabItem x:Name="WatermarkResultTab" Visibility="Collapsed" Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:WatermarkRemoval}" />
        <TabItem x:Name="TextResultTab" Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:TextOCR}"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,8">
            <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionOcrHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
            <WrapPanel>
            <ComboBox x:Name="TargetLanguageBox" Width="150" SelectionChanged="TargetLanguage_Changed" />
            <Button x:Name="TranslateButton" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Translate}" Click="Translate_Click" />
            <ComboBox x:Name="TextViewBox" Width="100" SelectionChanged="TextView_Changed">
              <ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:SourceText}" Tag="Source" />
              <ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:TranslatedTextView}" Tag="Translation" />
              <ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:BilingualText}" Tag="Bilingual" />
            </ComboBox>
            </WrapPanel>
          </StackPanel>
          <TextBox x:Name="TextEditor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" FontSize="16" TextChanged="Text_Changed" />
          <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,6,0,0"><Button Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:TranslationSettings}" Click="TranslationSettings_Click" /></StackPanel>
        </Grid></TabItem>
        <TabItem x:Name="SummaryResultTab" Visibility="Collapsed" Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:CaptureSummary}">
          <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionSummaryHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
            <TextBox x:Name="SummaryEditor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" FontSize="16" TextChanged="CommonDocument_Changed" />
            <Expander Grid.Row="2" Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:SourceText}" Margin="0,8,0,0">
              <TextBox x:Name="SummarySourceEditor" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="160" Padding="8" />
            </Expander>
            <Button x:Name="SummarySettingsButton" Grid.Row="3" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:CaptureSummaryConfigure}" Click="TranslationSettings_Click" HorizontalAlignment="Left" Margin="0,8,0,0" />
          </Grid>
        </TabItem>
        <TabItem x:Name="BarcodeResultTab" Visibility="Collapsed" Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionBarcodeNavigation}">
          <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
            <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionBarcodeHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
            <TextBox x:Name="BarcodeEditor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" FontSize="16" TextChanged="CommonDocument_Changed" />
          </Grid>
        </TabItem>
        <TabItem x:Name="FormulaResultTab" Visibility="Collapsed" Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionFormulaTool}">
          <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
            <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionFormulaHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
            <TextBox x:Name="FormulaEditor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="10" FontFamily="Consolas" FontSize="16" TextChanged="CommonDocument_Changed" />
          </Grid>
        </TabItem>
        <TabItem x:Name="TableResultTab" Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:TableCorrection}"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionTableHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
          <DataGrid x:Name="CellsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="True"><DataGrid.Columns>
            <DataGridTextColumn Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Row}" Binding="{Binding Row}" Width="SizeToHeader" MinWidth="40" /><DataGridTextColumn Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Column}" Binding="{Binding Column}" Width="SizeToHeader" MinWidth="40" /><DataGridTextColumn Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RowSpan}" Binding="{Binding RowSpan}" Width="SizeToHeader" MinWidth="45" /><DataGridTextColumn Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ColumnSpan}" Binding="{Binding ColumnSpan}" Width="SizeToHeader" MinWidth="45" /><DataGridTextColumn Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Text2}" Binding="{Binding Text}" Width="*" />
          </DataGrid.Columns></DataGrid>
        </Grid></TabItem>
        <TabItem x:Name="CutoutResultTab" Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:BackgroundRemovalOutput}" />
        <TabItem x:Name="DocumentResultTab" Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:IdentityFields}" Visibility="Collapsed">
          <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8"><Button x:Name="ChangeDocumentTypeButton" DockPanel.Dock="Right" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ChangeDocumentType}" Click="ChangeDocumentType_Click" /><TextBlock x:Name="DocumentTypeText" Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:DocumentUnknown}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
            <TextBlock Grid.Row="1" Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:DocumentFieldsHint}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
            <TextBox x:Name="DocumentEditor" Grid.Row="2" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" FontSize="16" SelectionChanged="DocumentText_Selected" TextChanged="CommonDocument_Changed" />
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>
    <DockPanel Grid.Row="2" Margin="0,4,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
<Button Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ImageSearch}" Click="Search_Click" /><Button Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Close}" Click="Close_Click" /></StackPanel><TextBlock x:Name="Status" Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Ready}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" /></DockPanel>
    </Grid>
  </Grid>
</Window>
