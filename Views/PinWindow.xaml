<Window x:Class="SnapSharp.Views.PinWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="http://wpflocalizeextension.codeplex.com"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SnapSharp.Views"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        WindowStyle="None" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        PreviewMouseRightButtonDown="Window_PreviewMouseRightButtonDown"
        MouseWheel="Window_MouseWheel">
  <Window.Resources><ResourceDictionary>
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ToolbarStyles.xaml" /></ResourceDictionary.MergedDictionaries>
    <Style x:Key="PinToolButton" TargetType="Button">
      <Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" />
      <Setter Property="Margin" Value="1" /><Setter Property="Padding" Value="6" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlHoverBrush}" /></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2868D8" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource ToolbarIcon}">
      <Setter Property="Width" Value="20" /><Setter Property="Height" Value="20" />
    </Style>
    <ContextMenu x:Key="PinMenu" Style="{StaticResource AppContextMenu}" Opened="Menu_Opened">
      <MenuItem Header="{loc:Loc SnapSharp.Core:Resources.Strings:EditAnnotations}" Click="BeginEdit_Click" />
      <MenuItem Header="{loc:Loc SnapSharp.Core:Resources.Strings:FinishEditing}" Click="ApplyEdit_Click" />
      <MenuItem Header="{loc:Loc SnapSharp.Core:Resources.Strings:CopyImage}" Click="Copy_Click" />
      <MenuItem Header="{loc:Loc SnapSharp.Core:Resources.Strings:SaveAs}" Click="Save_Click" />
      <MenuItem Header="{loc:Loc SnapSharp.Core:Resources.Strings:RecognizeTextBarcodes}" Tag="OCR" Click="Recognition_Click" />
      <MenuItem Header="{loc:Loc SnapSharp.Core:Resources.Strings:RemoveBackground2}" Tag="Cutout" Click="Recognition_Click" />
      <MenuItem Header="{loc:Loc SnapSharp.Core:Resources.Strings:ToggleAlwaysOnTop}" Click="ToggleTopmost_Click" />
      <MenuItem Header="{loc:Loc SnapSharp.Core:Resources.Strings:Opacity}">
        <MenuItem Header="100%" Tag="1" Click="Opacity_Click" />
        <MenuItem Header="75%" Tag="0.75" Click="Opacity_Click" />
        <MenuItem Header="50%" Tag="0.5" Click="Opacity_Click" />
        <MenuItem Header="25%" Tag="0.25" Click="Opacity_Click" />
      </MenuItem>
      <MenuItem Header="{loc:Loc SnapSharp.Core:Resources.Strings:RotateLeft}" Tag="-90" Click="Rotate_Click" />
      <MenuItem Header="{loc:Loc SnapSharp.Core:Resources.Strings:RotateRight}" Tag="90" Click="Rotate_Click" />
      <MenuItem Header="{loc:Loc SnapSharp.Core:Resources.Strings:ClickThrough}" Click="ClickThrough_Click" />
      <MenuItem Header="{loc:Loc SnapSharp.Core:Resources.Strings:RestoreOriginalSize}" Click="ResetSize_Click" />
      <Separator />
      <MenuItem Header="{loc:Loc SnapSharp.Core:Resources.Strings:Group}" Tag="Groups" />
      <MenuItem Header="{loc:Loc SnapSharp.Core:Resources.Strings:HideGroupRestoreFromTray}" Tag="HideGroup" Click="HideGroup_Click" />
      <MenuItem Header="{loc:Loc SnapSharp.Core:Resources.Strings:CloseGroup}" Tag="CloseGroup" Click="CloseGroup_Click" />
      <Separator />
      <MenuItem Header="{loc:Loc SnapSharp.Core:Resources.Strings:Close}" Click="Close_Click" />
    </ContextMenu>
  </ResourceDictionary></Window.Resources>

  <Grid x:Name="Root">
    <Border x:Name="FrameBorder" Margin="10" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
      <Border.Effect>
        <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Opacity="0.55" />
      </Border.Effect>
      <Grid x:Name="ImageHost" ClipToBounds="True">
        <Image x:Name="ImageView" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"
               MouseLeftButtonDown="Image_MouseLeftButtonDown" />
        <local:AnnotationSurface x:Name="AnnotationView" Visibility="Collapsed"
                                 HorizontalAlignment="Left" VerticalAlignment="Top" />
      </Grid>
    </Border>

    <StackPanel x:Name="ColorCopyBar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="18" Visibility="Collapsed">
      <Button Content="{loc:Loc SnapSharp.Core:Resources.Strings:CopyHEX}" Click="CopyHex_Click" Style="{StaticResource DialogButton}" Margin="2" />
      <Button Content="{loc:Loc SnapSharp.Core:Resources.Strings:CopyRGB}" Click="CopyRgb_Click" Style="{StaticResource DialogButton}" Margin="2" />
    </StackPanel>

    <Border x:Name="EditToolbar" Visibility="Collapsed"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="18"
            MaxWidth="{Binding ActualWidth, ElementName=ImageHost}"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="8" Padding="6">
      <Border.Effect>
        <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Opacity="0.5" />
      </Border.Effect>
      <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
      <StackPanel x:Name="EditToolButtons" Orientation="Horizontal">
        <Button Style="{StaticResource PinToolButton}" Tag="Rectangle" Click="EditTool_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:Rectangle}"><iconPacks:PackIconLucide Kind="Square" /></Button>
        <Button Style="{StaticResource PinToolButton}" Tag="Ellipse" Click="EditTool_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:Ellipse}"><iconPacks:PackIconLucide Kind="Circle" /></Button>
        <Button Style="{StaticResource PinToolButton}" Tag="Line" Click="EditTool_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:Line}"><iconPacks:PackIconLucide Kind="Minus" /></Button>
        <Button Style="{StaticResource PinToolButton}" Tag="Arrow" Click="EditTool_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:Arrow}"><iconPacks:PackIconLucide Kind="ArrowUpRight" /></Button>
        <Button Style="{StaticResource PinToolButton}" Tag="Pen" Click="EditTool_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:Pen}"><iconPacks:PackIconLucide Kind="Pencil" /></Button>
        <Button Style="{StaticResource PinToolButton}" Tag="Highlight" Click="EditTool_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:Highlighter}"><iconPacks:PackIconLucide Kind="Highlighter" /></Button>
        <Button Style="{StaticResource PinToolButton}" Tag="Text" Click="EditTool_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:Text}"><iconPacks:PackIconLucide Kind="Type" /></Button>
        <Button Style="{StaticResource PinToolButton}" Tag="Watermark" Click="EditTool_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:Watermark}"><iconPacks:PackIconLucide Kind="Stamp" /></Button>
        <Button Style="{StaticResource PinToolButton}" Tag="Number" Click="EditTool_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:Number}"><iconPacks:PackIconLucide Kind="Hash" /></Button>
        <Button Style="{StaticResource PinToolButton}" Tag="Mosaic" Click="EditTool_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:Pixelate}"><iconPacks:PackIconLucide Kind="Grid3X3" /></Button>
        <Button Style="{StaticResource PinToolButton}" Tag="Blur" Click="EditTool_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:Blur}"><iconPacks:PackIconLucide Kind="Droplets" /></Button>
        <Button Style="{StaticResource PinToolButton}" Tag="Spotlight" Click="EditTool_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:Spotlight}"><iconPacks:PackIconLucide Kind="Focus" /></Button>
        <Button Style="{StaticResource PinToolButton}" Tag="Bubble" Click="EditTool_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:Callout}"><iconPacks:PackIconLucide Kind="MessageCircle" /></Button>
        <Button Style="{StaticResource PinToolButton}" Tag="Magnifier" Click="EditTool_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:MagnifierAnnotation}"><iconPacks:PackIconLucide Kind="ZoomIn" /></Button>
        <Button Style="{StaticResource PinToolButton}" Tag="Polygon" Click="EditTool_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:Polygon}"><iconPacks:PackIconLucide Kind="Pentagon" /></Button>
        <Button Style="{StaticResource PinToolButton}" Tag="Select" Click="EditTool_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:SelectObject}"><iconPacks:PackIconLucide Kind="MousePointer2" /></Button>
        <Button Style="{StaticResource PinToolButton}" Tag="Eraser" Click="EditTool_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:DeleteAnnotation}"><iconPacks:PackIconLucide Kind="Eraser" /></Button>
        <Separator Margin="6,7" />
        <Button Style="{StaticResource PinToolButton}" Click="EditColor_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:Color}"><iconPacks:PackIconLucide Kind="Palette" /></Button>
        <Button Style="{StaticResource PinToolButton}" Command="{Binding UndoCommand}" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:Undo}"><iconPacks:PackIconLucide Kind="Undo2" /></Button>
        <Button Style="{StaticResource PinToolButton}" Command="{Binding RedoCommand}" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:Redo}"><iconPacks:PackIconLucide Kind="Redo2" /></Button>
        <Separator Margin="6,7" />
        <Button Style="{StaticResource PinToolButton}" Click="ApplyEdit_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:FinishEditing}"><iconPacks:PackIconLucide Kind="Check" /></Button>
        <Button Style="{StaticResource PinToolButton}" Click="CancelEdit_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:CancelEditing}"><iconPacks:PackIconLucide Kind="X" /></Button>
        <Button Style="{StaticResource PinToolButton}" Click="More_Click" ToolTip="{loc:Loc SnapSharp.Core:Resources.Strings:More}"><iconPacks:PackIconLucide Kind="Menu" /></Button>
      </StackPanel>
      </Viewbox>
    </Border>
  </Grid>
</Window>
