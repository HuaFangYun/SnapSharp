<Window x:Class="SnapSharp.Views.TextInputDialog" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加文字" Width="440" Height="240" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Resources><ResourceDictionary>
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ToolbarStyles.xaml" /></ResourceDictionary.MergedDictionaries>
    <Style TargetType="TextBox" BasedOn="{StaticResource ToolbarTextBox}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource ToolbarComboBox}" />
    <Style TargetType="Button" BasedOn="{StaticResource DialogButton}" />
  </ResourceDictionary></Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBox x:Name="Input" Height="Auto" VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap" FontSize="16"
             Background="{DynamicResource ControlBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="8" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="取消" IsCancel="True" />
      <Button Content="确定" IsDefault="True" Click="Confirm_Click" Background="{DynamicResource ToolbarActiveBrush}" Foreground="{DynamicResource AccentForegroundBrush}" />
    </StackPanel>
  </Grid>
</Window>
