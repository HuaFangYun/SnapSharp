  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SnapSharp.Core\SnapSharp.Core.csproj" />
    <ProjectReference Include="..\SnapSharp.Imaging\SnapSharp.Imaging.csproj" />
