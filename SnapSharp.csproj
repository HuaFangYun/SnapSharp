<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <IsSnapSharpApp>true</IsSnapSharpApp>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <AssemblyName>SnapSharp</AssemblyName>
    <RootNamespace>SnapSharp</RootNamespace>
    <Version>1.0.8</Version>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <Microsoft_AI_DirectML_SkipDebugLayerCopy>true</Microsoft_AI_DirectML_SkipDebugLayerCopy>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="MahApps.Metro.IconPacks.Lucide" Version="6.2.1" />
    <PackageReference Include="ScreenRecorderLib" Version="7.0.1" />
    <PackageReference Include="GTranslate" Version="2.4.0" />
    <!-- Direct dependency imports the native copy target in the x64 app,
         rather than relying on the OS copy of DirectML.dll. -->
    <PackageReference Include="Microsoft.AI.DirectML" Version="1.15.4" />
    <PackageReference Include="WPFLocalizeExtension" Version="3.10.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Libraries\SnapSharp.Core\SnapSharp.Core.csproj" />
    <ProjectReference Include="Libraries\SnapSharp.Imaging\SnapSharp.Imaging.csproj" />
    <ProjectReference Include="Libraries\SnapSharp.Recognition\SnapSharp.Recognition.csproj" />
    <ProjectReference Include="Libraries\SnapSharp.Editor\SnapSharp.Editor.csproj" />
    <ProjectReference Include="Libraries\SnapSharp.Capture\SnapSharp.Capture.csproj" />
    <ProjectReference Include="Libraries\SnapSharp.Infrastructure\SnapSharp.Infrastructure.csproj" />
    <ProjectReference Include="Libraries\SnapSharp.Plugin.Abstractions\SnapSharp.Plugin.Abstractions.csproj" />
    <ProjectReference Include="Libraries\SnapSharp.PluginHost\SnapSharp.PluginHost.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Views\SelectionWindow.xaml.cs" />
    <Compile Remove="Libraries\**\*.cs" />
    <Compile Remove="tools\RegressionChecks\**\*.cs" />
    <Page Remove="Libraries\**\*.xaml" />
    <EmbeddedResource Remove="Libraries\**\*" />
    <Resource Include="logo.ico" />
  </ItemGroup>
  <ItemGroup>
    <None Update="LICENSE;THIRD-PARTY-NOTICES.md;README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="ThirdPartyLicenses\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SnapSharp.RegressionChecks" />
  </ItemGroup>
</Project>
